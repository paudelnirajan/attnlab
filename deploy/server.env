# Production settings for the server: MacBook Pro M1 Pro, 16 GB RAM, 256 GB SSD.
# Committed and secret-free. Put overrides and secrets (HEALTHCHECK_URL) in
# ~/attnlab/shared/local.env on the server, which is read after this file.
# Every value is explained in docs/04-self-hosting.md.

# --- process setup (must be in the environment before Python starts) ---
MallocLargeCache=0          # D17: halves the footprint after a model load on macOS
HF_HUB_OFFLINE=1            # D18: never download while serving; deploy fetches instead
HF_HUB_DISABLE_TELEMETRY=1
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1

# --- compute ---
MI_DEVICE=cpu               # D16: faster than MPS for these models, and exact
MI_THREADS=6                # the M1 Pro has 8 performance cores; leave 2 for macOS

# --- memory (16 GB total; macOS and headroom keep ~5 GB) ---
MI_RAM_BUDGET_GB=7          # models, including each load's peak
MI_RUN_BUDGET_MB=512        # stored attention runs (encoded)
MI_LENS_BUDGET_MB=512       # stored logit-lens runs
MI_MEMORY_LIMIT_GB=10.5     # whole process: free caches, evict, then refuse

# --- load ---
MI_MAX_QUEUE=8              # requests waiting for the model; the next gets 503 busy
MI_REQUEST_TIMEOUT_S=30
MI_TOKENIZER_CONCURRENCY=2
MI_MAX_TEXT_CHARS=10000
MI_MAX_BODY_BYTES=262144
MI_RATE_BURST=60            # per client, over POST /api/*
MI_RATE_PER_S=1
MI_TRUST_PROXY=1            # only reachable through the Cloudflare Tunnel (127.0.0.1)
MI_PRELOAD=1                # load the baked models at startup

# --- server ---
API_HOST=127.0.0.1          # never 0.0.0.0: the tunnel is the only way in
API_PORT=8000

# --- watchdog (deploy/watchdog.sh, every minute) ---
WATCHDOG_KILL_GB=12.5       # restart the API if its footprint passes this anyway
WATCHDOG_MIN_FREE_DISK_GB=15
WATCHDOG_MAX_SWAP_GB=2
